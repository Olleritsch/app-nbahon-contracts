{
  "name": "app-nbahon-contracts",
  "version": "2.0.0",
  "private": true,
  "description": "Zentrale OpenAPI 3.1 Schnittstellenverträge für das nbahon-Ökosystem",
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "build:pages": "npm run bundle && node scripts/prepare-pages.js",
    "lint": "spectral lint \"dist/*-latest.yaml\" --ruleset .spectral.yaml",
    "test": "npm run bundle && npm run lint",
    "preview:core": "redocly preview-docs contracts/core/v1/openapi.yaml",
    "preview:connector": "redocly preview-docs contracts/connectors/interface/v2/openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "@stoplight/spectral-cli": "^6.14.3",
    "@stoplight/spectral-rulesets": "^1.21.2"
  }
}
